set term pdf
# noenhanced so that the underscores in the column headers stay literal rather than
# being read as subscript markup
set key autotitle columnhead outside right noenhanced

# train = solid, validation = dashed, test = dotted
# F4 = red, growthrate = green, negative_density = blue, fluxfac = magenta

set output "traintest.pdf"
set log y
plot 'loss.dat' u 1:26 w l, \
     '' u 1:27 w l, \
     '' u 1:28 w l
unset output

set output "maxes.pdf"
set log y
plot 'loss.dat' u 1:3  w l      lc "red", \
     '' u 1:9  w l      lc "green", \
     '' u 1:15 w l      lc "blue", \
     '' u 1:21 w l      lc "magenta", \
     '' u 1:5  w l dt 2 lc "red", \
     '' u 1:11 w l dt 2 lc "green", \
     '' u 1:17 w l dt 2 lc "blue", \
     '' u 1:23 w l dt 2 lc "magenta", \
     '' u 1:7  w l dt 3 lc "red", \
     '' u 1:13 w l dt 3 lc "green", \
     '' u 1:19 w l dt 3 lc "blue", \
     '' u 1:25 w l dt 3 lc "magenta"
unset output

set output "learning_rate.pdf"
set log y
plot 'loss.dat' u 1:29 w l
unset output

set output "losses.pdf"
set log y
# wide enough to keep the unphysical losses on the plot - they are many orders of
# magnitude below the F4 loss once the model is anywhere near the physical region
set yrange [1e-12:2]
plot 'loss.dat' u 1:2  w l      lc "red", \
     '' u 1:8  w l      lc "green", \
     '' u 1:14 w l      lc "blue", \
     '' u 1:20 w l      lc "magenta", \
     '' u 1:4  w l dt 2 lc "red", \
     '' u 1:10 w l dt 2 lc "green", \
     '' u 1:16 w l dt 2 lc "blue", \
     '' u 1:22 w l dt 2 lc "magenta", \
     '' u 1:6  w l dt 3 lc "red", \
     '' u 1:12 w l dt 3 lc "green", \
     '' u 1:18 w l dt 3 lc "blue", \
     '' u 1:24 w l dt 3 lc "magenta"
unset output
